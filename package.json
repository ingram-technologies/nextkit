{
	"name": "nextkit",
	"version": "0.0.0",
	"private": true,
	"description": "A super-thin, opinionated foundation for Ingram Technologies' Next.js websites.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/nextkit.git"
	},
	"homepage": "https://github.com/ingram-technologies/nextkit#readme",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter '*' build",
		"lint": "oxlint",
		"format": "oxfmt --write .",
		"check": "oxlint && oxfmt --check .",
		"type-check": "bun run --filter '*' type-check",
		"test": "bun run --filter '*' test",
		"ci": "bun run check && bun run build && bun run type-check && bun run test",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"publish-packages": "bun run scripts/publish.ts",
		"release": "bun run build && bun run publish-packages && changeset tag",
		"prepare": "git config core.hooksPath .githooks || true"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"oxfmt": "^0.55.0",
		"oxlint": "^1.70.0",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.2.0",
	"engines": {
		"node": ">=24"
	}
}
