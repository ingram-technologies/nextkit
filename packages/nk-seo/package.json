{
	"name": "@ingram-tech/nk-seo",
	"version": "0.8.0",
	"description": "SEO primitives for Next.js sites: typed schema.org JSON-LD builders, a <JsonLd> tag, a Metadata factory (canonical + OG + Twitter), and configurable hreflang alternates.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/nextkit.git",
		"directory": "packages/nk-seo"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./components": {
			"types": "./dist/components.d.ts",
			"import": "./dist/components.js"
		},
		"./og": {
			"types": "./dist/og.d.ts",
			"import": "./dist/og.js"
		},
		"./verify": {
			"types": "./dist/verify.d.ts",
			"import": "./dist/verify.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@ingram-tech/nk-dev": "workspace:*",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"next": "^16.3.1",
		"react": "^19.2.8",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10",
		"@ingram-tech/nk-i18n": "workspace:*"
	},
	"peerDependencies": {
		"next": ">=14.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	}
}
