{
	"name": "@ingram-tech/nk-api",
	"version": "0.3.5",
	"description": "The Ingram HTTP API seam: a Hono + zod-openapi app factory, a single error envelope, an auth-middleware factory, and Next.js + typed-client adapters — the standard alternative to auto-generated REST APIs.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/nextkit.git",
		"directory": "packages/nk-api"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./next": {
			"types": "./dist/next.d.ts",
			"import": "./dist/next.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@hono/swagger-ui": "^0.6.1"
	},
	"peerDependencies": {
		"@hono/zod-openapi": ">=1.4.0",
		"hono": ">=4.12.0"
	},
	"devDependencies": {
		"@hono/zod-openapi": "^1.6.0",
		"@ingram-tech/nk-dev": "workspace:*",
		"@types/node": "^26.2.0",
		"hono": "^4.13.2",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
