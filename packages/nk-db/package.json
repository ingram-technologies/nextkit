{
	"name": "@ingram-tech/nk-db",
	"version": "1.3.0",
	"description": "The Ingram Postgres data layer: one TLS-aware pg pool, raw-SQL helpers, Drizzle wiring, and a PGlite (no-Docker) dev/test harness for Next.js sites.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/nextkit.git",
		"directory": "packages/nk-db"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"bin": {
		"nk-pglite-dev": "./dist/pglite/dev.js",
		"nk-pg-migrate": "./dist/migrate-bin.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./id": {
			"types": "./dist/id.d.ts",
			"import": "./dist/id.js"
		},
		"./migrate": {
			"types": "./dist/migrate.d.ts",
			"import": "./dist/migrate.js"
		},
		"./pglite": {
			"types": "./dist/pglite/index.d.ts",
			"import": "./dist/pglite/index.js"
		},
		"./pglite/reset": {
			"types": "./dist/pglite/reset.d.ts",
			"import": "./dist/pglite/reset.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@electric-sql/pglite": ">=0.5.0",
		"@electric-sql/pglite-socket": ">=0.2.4",
		"drizzle-orm": ">=0.44.0",
		"pg": "^8.13.0"
	},
	"peerDependenciesMeta": {
		"@electric-sql/pglite": {
			"optional": true
		},
		"@electric-sql/pglite-socket": {
			"optional": true
		}
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.4",
		"@electric-sql/pglite-socket": "^0.2.7",
		"@ingram-tech/nk-dev": "workspace:*",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.22.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
