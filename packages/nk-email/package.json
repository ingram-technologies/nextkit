{
	"name": "@ingram-tech/nk-email",
	"version": "0.6.2",
	"description": "Zero-dependency Cloudflare Email Sending client for Ingram Technologies Next.js projects.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/nextkit.git",
		"directory": "packages/nk-email"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"migrations"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./migrations/*": "./migrations/*"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"devDependencies": {
		"@ingram-tech/nk-dev": "workspace:*",
		"@types/node": "^26.4.0",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
