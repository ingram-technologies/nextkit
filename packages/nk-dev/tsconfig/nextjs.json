{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "@ingram-tech/typescript-config (Next.js app)",
	"extends": "./base.json",
	"compilerOptions": {
		"lib": ["dom", "dom.iterable", "esnext"],
		// Next apps let the bundler resolve modules — keep "bundler" here so app
		// source needn't use .js import extensions. (base.json is "nodenext" for
		// published packages; this override insulates apps from that.)
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "preserve",
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		// TS 7 sizes its checker pool to the CPU count, and `next build` runs tsc
		// against this config: the default pool peaks near 7 GB and OOMs a
		// standard Vercel build machine. One checker costs ~3.3 GB and a few
		// seconds; `tsc --checkers N` still overrides it for a local run.
		"checkers": 1,
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
