{
	"plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
	"jsPlugins": ["@ingram-tech/nk-dev/oxlint-plugin"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"nextkit/no-radix-props-on-base-ui": "error",
		"nextkit/no-deferred-current-target": "error",
		"nextkit/no-redundant-usestate-type": "warn",
		"nextkit/lucide-icon-suffix": "warn",
		"nextkit/no-redirect-only-page": "warn",
		"nextkit/t-requires-values": "error",
		"nextkit/t-no-positional-args": "error",
		"nextkit/no-crypto-random-uuid": "warn",
		"nextkit/no-id-codec-in-app-code": "warn",
		"nextkit/no-redundant-node-crypto": "warn",
		"nextkit/satori-css": "warn",
		"nextkit/no-server-env-in-client": "error",
		"nextkit/no-sql-array-cast": "error",
		"no-unused-vars": "warn",
		"typescript/no-non-null-assertion": "error",
		"typescript/no-explicit-any": "error",
		"typescript/consistent-type-imports": "off",
		"unicorn/prefer-node-protocol": "off",
		"react/exhaustive-deps": "warn",
		"react/no-array-index-key": "off",
		"react/no-danger": "off",
		"jsx-a11y/label-has-associated-control": "off",
		"jsx-a11y/click-events-have-key-events": "off",
		"jsx-a11y/no-static-element-interactions": "off",
		"jsx-a11y/interactive-supports-focus": "off",
		"jsx-a11y/control-has-associated-label": "off",
		"jsx-a11y/prefer-tag-over-role": "off",
		"jsx-a11y/no-autofocus": "off",
		"jsx-a11y/role-has-required-aria-props": "off"
	},
	"overrides": [
		{
			"files": ["**/__tests__/**", "**/*.test.*", "**/*.spec.*", "**/test/**"],
			"rules": {
				"nextkit/no-crypto-random-uuid": "off",
				"nextkit/no-id-codec-in-app-code": "off"
			}
		}
	]
}
