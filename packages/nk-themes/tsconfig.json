{
	"extends": "@ingram-tech/nk-dev/tsconfig/base.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		// Override the base's "nodenext": next.tsx imports @wrksz/themes/next,
		// which pulls next/headers — whose type exports don't resolve under
		// NodeNext. Build with "bundler" like a Next app (same carve-out as
		// nk-seo/nk-auth). Relative imports keep explicit .js extensions, so the
		// published dist is valid Node ESM regardless.
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		// The client entry renders JSX (ThemeToggle) and touches DOM element types.
		"lib": ["esnext", "dom", "dom.iterable"],
		"types": ["node", "react"]
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
