{
	"name": "@ingram-tech/nk-themes",
	"version": "0.2.1",
	"description": "Color-mode theming for Next.js sites: a zero-flash cookie-backed <ThemeProvider>, a re-exported useTheme, and a headless <ThemeToggle>, wrapping @wrksz/themes behind one pinned version.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/nextkit.git",
		"directory": "packages/nk-themes"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./next": {
			"types": "./dist/next.d.ts",
			"import": "./dist/next.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@wrksz/themes": "^1.2.0"
	},
	"devDependencies": {
		"@ingram-tech/nk-dev": "workspace:*",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"next": "^16.3.1",
		"react": "^19.2.8",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"next": ">=14.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	}
}
