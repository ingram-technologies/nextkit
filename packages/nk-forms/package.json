{
	"name": "@ingram-tech/nk-forms",
	"version": "0.2.4",
	"description": "Contact/signup form pipeline for Next.js sites \u2014 bot protection, validation, and escaped email notifications in one handler.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/nextkit.git",
		"directory": "packages/nk-forms"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@ingram-tech/bot-protection": "workspace:*",
		"@ingram-tech/nk-email": "workspace:*"
	},
	"devDependencies": {
		"@ingram-tech/nk-dev": "workspace:*",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"react": "^19.2.7",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
