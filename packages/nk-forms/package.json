{
	"name": "@ingram-tech/nk-forms",
	"version": "0.3.0",
	"description": "Contact/signup form pipeline for Next.js sites — invisible bot protection (honeypot + signed timing token + Vercel BotID), validation, and escaped email notifications in one handler.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/nextkit.git",
		"directory": "packages/nk-forms"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./honeypot": {
			"types": "./dist/bot/honeypot.d.ts",
			"import": "./dist/bot/honeypot.js"
		},
		"./fields": {
			"types": "./dist/bot/fields.d.ts",
			"import": "./dist/bot/fields.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@ingram-tech/nk-email": "workspace:*"
	},
	"devDependencies": {
		"@ingram-tech/nk-dev": "workspace:*",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"react": "^19.2.8",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"botid": ">=1.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"botid": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	}
}
