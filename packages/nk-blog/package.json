{
	"name": "@ingram-tech/nk-blog",
	"version": "0.1.7",
	"description": "File-based blog foundation for Next.js sites: frontmatter schema, build-time reader, limited-MDX rendering, a typed component contract with unstyled defaults, GitHub read/publish, and RSS.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/nextkit.git",
		"directory": "packages/nk-blog"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./render": {
			"types": "./dist/render.d.ts",
			"import": "./dist/render.js"
		},
		"./unstyled": {
			"types": "./dist/unstyled/index.d.ts",
			"import": "./dist/unstyled/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@ingram-tech/nk-seo": "workspace:^",
		"@mdx-js/mdx": "^3.1.1",
		"gray-matter": "^4.0.3",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"next": ">=14.0.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"next": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@ingram-tech/nk-dev": "workspace:*",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"mdast-util-mdx-jsx": "^3.2.0",
		"next": "^16.3.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "^7.0.2",
		"unified": "^11.0.5",
		"vfile": "^6.0.3",
		"vitest": "^4.1.10"
	}
}
