{
	"name": "@ingram-tech/nk-auth",
	"version": "0.16.1",
	"description": "The Ingram Better Auth foundation: composable presets (org, dual-shape JWT, active-org hooks, pg pool) for Next.js sites.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/nextkit.git",
		"directory": "packages/nk-auth"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"migrations"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./id": {
			"types": "./dist/id.d.ts",
			"import": "./dist/id.js"
		},
		"./jwt": {
			"types": "./dist/jwt.d.ts",
			"import": "./dist/jwt.js"
		},
		"./organization": {
			"types": "./dist/organization.d.ts",
			"import": "./dist/organization.js"
		},
		"./pool": {
			"types": "./dist/pool.d.ts",
			"import": "./dist/pool.js"
		},
		"./paths": {
			"types": "./dist/paths.d.ts",
			"import": "./dist/paths.js"
		},
		"./password": {
			"types": "./dist/password.d.ts",
			"import": "./dist/password.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./middleware": {
			"types": "./dist/middleware.d.ts",
			"import": "./dist/middleware.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		},
		"./migrations/*": "./migrations/*"
	},
	"scripts": {
		"build": "rm -rf dist *.tsbuildinfo && tsc -p tsconfig.build.json",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@ingram-tech/nk-db": "workspace:^",
		"bcrypt": "^6.0.0",
		"jose": "^6.2.11",
		"zod": "^4.5.4"
	},
	"peerDependencies": {
		"@better-auth/passkey": "^1.7.2",
		"better-auth": "^1.7.2",
		"next": "^15.0.0 || ^16.0.0",
		"pg": "^8.13.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"@better-auth/passkey": {
			"optional": true
		},
		"next": {
			"optional": true
		},
		"pg": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@better-auth/passkey": "^1.7.2",
		"@ingram-tech/nk-dev": "workspace:*",
		"@types/bcrypt": "^6.0.0",
		"@types/node": "^26.4.1",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"better-auth": "^1.7.2",
		"next": "^16.3.4",
		"pg": "^8.23.0",
		"react": "^19.2.8",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	}
}
